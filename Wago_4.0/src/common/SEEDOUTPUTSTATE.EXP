
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '0' *)
PROGRAM SeedOutputState
VAR
	cpt: INT;
	tmp: INT;
	addr: WORD;
	val: BOOL;
	val2: BOOL;
END_VAR

(* @END_DECLARATION := '0' *)
(* Only TELERUPTEUR and VOLET are seeded. DALI and DMX do not go through
   OutArrState; DIRECT reasserts itself every cycle; VOLET_IMPULSE publishes
   its bits outside the event guard, so a seeded bit would stay latched.
   sens, mode and imp are not in the output image: the first press after a
   changeover stops the volet, the one after may pick the wrong way. *)

FOR cpt := 0 TO 512 DO

	IF (output_type[cpt] = TELERUPTEUR) THEN

		tmp := cpt;
		IF (output_addr[cpt].SameAs >= 0) THEN
			tmp := output_addr[cpt].SameAs;
		END_IF

		addr := output_addr[tmp].ADDR1 + start_addr_out;
		val := BYTE_TO_BOOL(SHR(OutArrState[addr / 8], addr MOD 8) AND 16#01);
		IF (val = TRUE) THEN
			lights[tmp / 8] := lights[tmp / 8] OR SHL(BYTE#1, tmp MOD 8);
		ELSE
			lights[tmp / 8] := lights[tmp / 8] AND NOT SHL(BYTE#1, tmp MOD 8);
		END_IF

	END_IF

	IF (output_type[cpt] = VOLET) THEN

		tmp := cpt;
		IF (output_addr[cpt].SameAs >= 0) THEN
			tmp := output_addr[cpt].SameAs;
		END_IF

		(* The rule reached through SameAs must be a VOLET too: seeding a
		   VOLET_IMPULSE instance would latch its relay for good. *)
		IF (output_type[tmp] = VOLET) THEN
			addr := output_addr[tmp].ADDR1 + start_addr_out;
			val := BYTE_TO_BOOL(SHR(OutArrState[addr / 8], addr MOD 8) AND 16#01);
			addr := output_addr[tmp].ADDR2 + start_addr_out;
			val2 := BYTE_TO_BOOL(SHR(OutArrState[addr / 8], addr MOD 8) AND 16#01);
			volets[tmp](SEED := TRUE, SEED_MONTE := val, SEED_DESCENTE := val2);
		END_IF

	END_IF

END_FOR
END_PROGRAM
