
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK VOLET
VAR
	sens: BOOL;
	imp: TP;
	mode: VOLET_MODE;
END_VAR
VAR_INPUT
	IN: BOOL;
	IMPULSE: BOOL;
	(* Written only by SeedOutputState *)
	SEED: BOOL;
	SEED_MONTE: BOOL;
	SEED_DESCENTE: BOOL;
END_VAR
VAR_OUTPUT
	MONTE: BOOL;
	DESCENTE:BOOL;
END_VAR
(* @END_DECLARATION := '0' *)
(* Volet *)

(* MONTE and DESCENTE are VAR_OUTPUT: CoDeSys 2.3 refuses to write them from
   outside, so seeding happens here. SEED clears itself, otherwise the next
   press would return immediately and the volet would stay inert.
   sens, mode and imp are not in the output image: seeding is partial. *)
IF SEED = TRUE THEN
	SEED := FALSE;
	MONTE := SEED_MONTE;
	DESCENTE := SEED_DESCENTE;
	RETURN;
END_IF

IF IMPULSE = FALSE THEN
	(* Normal mode *)
	IF (MONTE = TRUE OR DESCENTE = TRUE) THEN
		MONTE := FALSE;
		DESCENTE := FALSE;
	ELSE

		IF IN = TRUE THEN
			IF sens = TRUE THEN
				sens := FALSE;
			ELSE
				sens := TRUE;
			END_IF;

			IF sens = TRUE THEN
				(*monte*)
				DESCENTE := FALSE;
				MONTE := TRUE;
			ELSE
				MONTE := FALSE;
				DESCENTE := TRUE;
			END_IF;
		END_IF

	END_IF
ELSE
	(* impulse mode *)
	imp(IN := FALSE, PT:= impulse_time);

	IF mode = IMP_STOP THEN
		MONTE := imp.Q;
		DESCENTE := imp.Q;
		IF imp.Q = FALSE THEN
			mode := VOLET_STOP;
		END_IF;
	END_IF;
	IF mode = IMP_UP THEN
		MONTE := imp.Q;
		DESCENTE := FALSE;
		IF imp.Q = FALSE THEN
			mode := VOLET_UP;
		END_IF;
	END_IF;
	IF mode = IMP_DOWN THEN
		MONTE := FALSE;
		DESCENTE := imp.Q;
		IF imp.Q = FALSE THEN
			mode := VOLET_DOWN;
		END_IF;
	END_IF;

	IF mode = VOLET_UP OR mode = VOLET_DOWN THEN
		IF IN = TRUE THEN
			imp(IN := TRUE, PT:= impulse_time);
			mode := IMP_STOP;
		END_IF;
	ELSE
		IF IN = TRUE THEN
			IF sens = TRUE THEN
				sens := FALSE;
			ELSE
				sens := TRUE;
			END_IF;

			IF sens = TRUE THEN
				imp(IN := TRUE, PT:= impulse_time);
				mode := IMP_UP;
			ELSE
				imp(IN := TRUE, PT:= impulse_time);
				mode := IMP_DOWN;
			END_IF;
		END_IF;
	END_IF;
END_IF;
END_FUNCTION_BLOCK
