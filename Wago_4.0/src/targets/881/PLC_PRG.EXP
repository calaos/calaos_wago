
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '0' *)
PROGRAM PLC_PRG
VAR
	i: INT;
	j: INT;
	start: BYTE;
	init_dali: BOOL := FALSE;
	valw: WORD;
	hb_trig: F_TRIG;

	led: LedUsr;

END_VAR
(* @END_DECLARATION := '0' *)
(* Main PRG *)
Config_File_XML();

(*DaliReadCsvFile(xStart := TRUE);*)

led(Mode := LedMode);

(* Start the config program *)
Config;

IF (Config.CONFIG_DALI = TRUE) THEN
	(* Call DALI jobs to send commands on the DALI bus *)
	DALIJoblist();
	DALI_Config();
END_IF

(* Read inputs and send their status on the network if they changed *)
SendInput;

(* Read a command from UDP *)
UDPServer;

(* Server just went away: rebuild the internal state from the mirrored
   output image before ManageOutput starts driving the outputs. *)
hb_trig(CLK := HEARTBEAT);
IF (hb_trig.Q = TRUE) THEN
	SeedOutputState;
END_IF

IF (HEARTBEAT = FALSE) THEN
 	ManageOutput;
END_IF

(* Run the DALI FB for 647 module *)
IF Config.CONFIG_DALI_647 = TRUE THEN
	DaliPrg647;
END_IF

IF (HEARTBEAT = FALSE) THEN

	j := start_addr_out / 8;
	FOR i := start_addr_out / 16 TO 255 DO
		valw := OutArrState[j + 1];
		write_word(WORD_ADDRESS := i, VALUE := SHL(valw, 8) + OutArrState[j]);
		j := j + 2;
	END_FOR
ELSE

	(* 16 words = the 32 bytes of netOutStandard, i.e. the 256 coils
	   4096..4351 of the address map; the loop stopped at 15 words and
	   left coils 4336..4351 unread.
	   Side effect worth knowing: these last two bytes are now published
	   every cycle in server mode. An output above the 240th therefore
	   follows the server, where it used to keep whatever ManageOutput had
	   left there at the last changeover.
	   Whether calaos_server writes past coil 4335 cannot be checked from
	   this repository; the loop is correct either way. *)
	j := 0;
	FOR i := 0 TO 15 DO
		valw := netOutStandard[j + 1];
		write_word(WORD_ADDRESS := i + start_addr_out / 16, VALUE := SHL(valw, 8) + netOutStandard[j]);
		OutArrState[start_addr_out / 8 + j] := netOutStandard[j];
		OutArrState[start_addr_out / 8 + j + 1] := netOutStandard[j + 1];
		j := j + 2;
	END_FOR

END_IF
END_PROGRAM
