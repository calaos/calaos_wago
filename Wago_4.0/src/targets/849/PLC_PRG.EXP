
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '0' *)
PROGRAM PLC_PRG
VAR
	i: INT;
	j: INT;
	start: BYTE;
	init_dali: BOOL := FALSE;
	valw: WORD;
	valOut: WORD;
	wa: INT;
	hb_trig: F_TRIG;

	led: LedUsr;

END_VAR
(* @END_DECLARATION := '0' *)
(* Main PRG *)
cycleCount := cycleCount + 1;

Config_File_XML();

(*DaliReadCsvFile(xStart := TRUE);*)

led(Mode := LedMode);

(* Start the config program *)
Config;

IF (Config.CONFIG_DALI = TRUE) THEN
	(* Call DALI jobs to send commands on the DALI bus *)
	DALIJoblist();
	DALI_Config();
END_IF

(* Read inputs and send their status on the network if they changed *)
SendInput;

(* handle all KNX stuff here *)
IF (Config.CONFIG_KNX = TRUE) THEN
	KNX_Master;
END_IF

(* Read a command from UDP *)
UDPServer;

(* Edge, never level: reseeding every cycle would stop standalone mode from
   driving anything. *)
hb_trig(CLK := HEARTBEAT);
IF (hb_trig.Q = TRUE) THEN
	SeedOutputState;
END_IF

IF (HEARTBEAT = FALSE) THEN
 	ManageOutput;
END_IF

(* Digital block kept before DaliPrg647 and on its own write_word_out instance:
   on a rack with a 647, digital outputs stayed dead when these writes shared
   write_word with the mailbox and ran after it. Guard on nb_module_out: with no
   digital output start_addr_out is 0 and the loops would write over the byte
   oriented module at the head of the image. *)
IF (nb_module_out > 0) THEN
	outLoopCount := outLoopCount + 1;
	writeErrDigital := FALSE;
	IF (HEARTBEAT = FALSE) THEN
		outBranch := 1;

		j := start_addr_out / 8;
		FOR i := start_addr_out / 16 TO 255 DO
			valw := OutArrState[j + 1];
			valOut := SHL(valw, 8) + OutArrState[j];
			write_word_out(WORD_ADDRESS := i, VALUE := valOut);
			IF (write_word_out.ERROR = TRUE) THEN
				writeErrDigital := TRUE;
			END_IF
			lastWritten[i] := valOut;
			lastWrittenValid[i] := TRUE;
			j := j + 2;
		END_FOR
	ELSE
		outBranch := 2;

		(* 16 words covers the 32 bytes of netOutStandard. Publishing the last two
		   means an output above the 240th follows the server instead of keeping
		   what ManageOutput left at the last changeover. *)
		j := 0;
		FOR i := 0 TO 15 DO
			wa := i + WORD_TO_INT(start_addr_out) / 16;
			valw := netOutStandard[j + 1];
			valOut := SHL(valw, 8) + netOutStandard[j];
			write_word_out(WORD_ADDRESS := INT_TO_WORD(wa), VALUE := valOut);
			IF (write_word_out.ERROR = TRUE) THEN
				writeErrDigital := TRUE;
			END_IF
			IF (wa <= 255) THEN
				lastWritten[wa] := valOut;
				lastWrittenValid[wa] := TRUE;
			END_IF
			OutArrState[start_addr_out / 8 + j] := netOutStandard[j];
			OutArrState[start_addr_out / 8 + j + 1] := netOutStandard[j + 1];
			j := j + 2;
		END_FOR

	END_IF
ELSE
	outBranch := 0;
END_IF

(* Run the DALI FB for 647 module *)
IF Config.CONFIG_DALI_647 = TRUE THEN
	DaliPrg647;
END_IF
END_PROGRAM
